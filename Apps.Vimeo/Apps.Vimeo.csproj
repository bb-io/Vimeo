<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net8.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <Product>Vimeo [Beta]</Product>
        <Description>Video hosting, sharing, and services platform </Description>
        <Version>1.1.0</Version>
        <EnableDynamicLoading>true</EnableDynamicLoading>
        <AssemblyName>Apps.Vimeo</AssemblyName>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Blackbird.Applications.Sdk.Common" Version="2.17.0" />
        <PackageReference Include="Blackbird.Applications.Sdk.Utils" Version="1.1.0-rc.8709" />
        <PackageReference Include="Blackbird.Applications.SDK.Extensions.FileManagement" Version="1.1.0" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Tests.Vimeo" />
    </ItemGroup>

    <ItemGroup>
        <EmbeddedResource Include="image\icon.png" CopyToOutputDirectory="Always" />
        <EmbeddedResource Include="..\README.md" Link="README.md" CopyToOutputDirectory="Always" />
    </ItemGroup>
</Project>
